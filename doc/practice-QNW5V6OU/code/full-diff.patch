+#!/usr/bin/env node
+/**
+ * CR-01 check runner. Runs `pnpm test` and `pnpm typecheck` in the app folder (src/) and writes
+ * machine-readable logs for the CR-01 evidence folder.
+ *
+ * Usage (from the src/ folder that holds package.json):
+ *   node CR-01-run-checks.mjs [evidenceDir]      default: ../answers/CR-01/evidence
+ *
+ * Writes <evidenceDir>/test.log and <evidenceDir>/typecheck.log as UTF-8, colours disabled.
+ * Each log starts with `command: ...` and ends with `exit_code: <n>`.
+ * Do not edit the logs. No dependencies; Node.js 18+.
+ */
+import { spawnSync } from "node:child_process";
+import { mkdirSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+
+const outDir = process.argv[2] ?? join("..", "answers", "CR-01", "evidence");
+mkdirSync(outDir, { recursive: true });
+
+const ANSI = /\u001b\[[0-9;?]*[ -\/]*[@-~]/g;
+
+function run(script, file) {
+  const res = spawnSync(`pnpm ${script}`, {
+    shell: true,
+    encoding: "utf8",
+    env: { ...process.env, NO_COLOR: "1", FORCE_COLOR: "0", CI: "1" },
+    maxBuffer: 64 * 1024 * 1024,
+  });
+  const output = `${res.stdout ?? ""}${res.stderr ?? ""}`.replace(ANSI, "").replace(/\r\n/g, "\n");
+  const code = res.status ?? 1;
+  const log = `command: pnpm ${script}\n${output.trimEnd()}\nexit_code: ${code}\n`;
+  writeFileSync(join(outDir, file), log, "utf8");
+  console.log(`pnpm ${script} -> exit_code ${code} (${join(outDir, file)})`);
+  return code;
+}
+
+const testCode = run("test", "test.log");
+const typecheckCode = run("typecheck", "typecheck.log");
+process.exitCode = testCode || typecheckCode ? 1 : 0;
diff --git a/QNW5V6OU/src/CR-01-signed-out-check.mjs b/QNW5V6OU/src/CR-01-signed-out-check.mjs
new file mode 100644
index 0000000..31ce7c9
--- /dev/null
+++ b/QNW5V6OU/src/CR-01-signed-out-check.mjs
@@ -0,0 +1,52 @@
+#!/usr/bin/env node
+/**
+ * CR-01 signed-out check. Sends one GET request without any cookie or credential to the
+ * data source your export uses (your export endpoint, or the invoice list query it reads),
+ * and writes a fixed-format verdict.
+ *
+ * Usage:
+ *   node CR-01-signed-out-check.mjs <url> <report.txt>
+ *   e.g. node CR-01-signed-out-check.mjs "http://localhost:3000/api/trpc/accounting.invoices" tc-04-signed-out-request.txt
+ *
+ * Verdict rules:
+ *   - status REJECTED  when the response is 401 or 403, or a redirect whose Location contains /login
+ *   - status ACCESSIBLE otherwise
+ *   - invoice_data_leaked yes when the body contains a CR-01 fixture invoice number (CR01-) or company name
+ * The report is written as UTF-8 by this script. No dependencies; Node.js 18+.
+ */
+import { writeFileSync } from "node:fs";
+
+const SEEDED_MARKERS = ["CR01-", "Alpha Design", "Beta Labs", "Gamma Studio", "Ánh Dương"];
+
+const [, , url, outPath] = process.argv;
+if (!url || !outPath) {
+  console.error("Usage: node CR-01-signed-out-check.mjs <url> <report.txt>");
+  process.exit(2);
+}
+
+let res;
+try {
+  res = await fetch(url, { method: "GET", redirect: "manual", credentials: "omit" });
+} catch (err) {
+  console.error(`Request failed: ${err.message}`);
+  process.exit(1);
+}
+const body = await res.text();
+const location = res.headers.get("location") ?? "";
+const rejected =
+  res.status === 401 ||
+  res.status === 403 ||
+  (res.status >= 300 && res.status < 400 && location.includes("/login"));
+const leaked = SEEDED_MARKERS.some((m) => body.includes(m));
+
+const report = [
+  "CR-01 signed-out check",
+  "cookies_sent: none",
+  `status: ${rejected ? "REJECTED" : "ACCESSIBLE"}`,
+  `invoice_data_leaked: ${leaked ? "yes" : "no"}`,
+].join("\n") + "\n";
+
+writeFileSync(outPath, report, "utf8");
+process.stdout.write(report);
+// Raw details go to stderr only, so they never change the evidence file.
+console.error(`[debug] ${url} -> HTTP ${res.status}${location ? ` Location: ${location}` : ""}`);
