diff --git a/DO6SQWGV/src/tests/invoice-csv.test.ts b/DO6SQWGV/src/tests/invoice-csv.test.ts
new file mode 100644
index 0000000..0aaaffa
--- /dev/null
+++ b/DO6SQWGV/src/tests/invoice-csv.test.ts
@@ -0,0 +1,74 @@
+import { afterAll, beforeEach, describe, expect, it, vi } from "vitest";
+import { invoiceCsv, INVOICE_CSV_HEADER, type InvoiceCsvRow } from "~/lib/invoice-csv";
+import { testDb, truncateAll } from "./helpers";
+
+vi.mock("~/server/auth", () => ({ auth: vi.fn() }));
+import { accountingRouter } from "~/server/api/routers/accounting";
+
+const row: InvoiceCsvRow = {
+  invoiceNumber: "INV-1", company: { name: "Alpha" },
+  issueDate: new Date("2026-10-01T00:00:00Z"), dueDate: null,
+  currencyCode: "USD", totalMinor: 12345, paidMinor: 2345, status: "PARTIAL",
+};
+
+describe("invoice CSV standard", () => {
+  it("emits a UTF-8 BOM and only the exact header for an empty selection", () => {
+    expect(invoiceCsv([])).toBe(`\uFEFF${INVOICE_CSV_HEADER}\r\n`);
+    expect([...Buffer.from(invoiceCsv([])).subarray(0, 3)]).toEqual([239, 187, 191]);
+  });
+  it("preserves order, status codes, calendar dates and partial payment balances", () => {
+    expect(invoiceCsv([row, { ...row, invoiceNumber: "INV-0", dueDate: new Date("2026-10-31T00:00:00Z") }]))
+      .toBe(`\uFEFF${INVOICE_CSV_HEADER}\r\nINV-1,Alpha,2026-10-01,,USD,123.45,23.45,100.00,PARTIAL\r\nINV-0,Alpha,2026-10-01,2026-10-31,USD,123.45,23.45,100.00,PARTIAL\r\n`);
+  });
+  it("preserves Vietnamese text, quotes, commas, newlines and surrounding spaces", () => {
+    expect(invoiceCsv([{ ...row, company: { name: ' Công ty "Ánh Dương", Chi nhánh 1\nHà Nội ' } }]))
+      .toContain('" Công ty ""Ánh Dương"", Chi nhánh 1\nHà Nội "');
+  });
+  it.each(["VND", "JPY", "KRW"])("uses zero decimal minor units for %s", (currencyCode) => {
+    expect(invoiceCsv([{ ...row, currencyCode }])).toContain(`,${currencyCode},12345,2345,10000,PARTIAL`);
+  });
+  it.each(["DRAFT", "VOID", "PAID"])("keeps %s with no receivable balance", (status) => {
+    expect(invoiceCsv([{ ...row, status }])).toContain(`,123.45,23.45,0.00,${status}`);
+  });
+  it("clamps overpayments and preserves negative amounts and currency casing", () => {
+    expect(invoiceCsv([{ ...row, paidMinor: 20000 }])).toContain(",123.45,200.00,0.00,PARTIAL");
+    expect(invoiceCsv([{ ...row, currencyCode: "eur", totalMinor: -10000, paidMinor: 0 }]))
+      .toContain(",EUR,-100.00,0.00,0.00,PARTIAL");
+  });
+});
+
+describe("authenticated export data source", () => {
+  beforeEach(truncateAll);
+  afterAll(() => testDb.$disconnect());
+  const caller = (signedIn: boolean) => accountingRouter.createCaller({
+    db: testDb, headers: new Headers(),
+    session: signedIn ? { user: { id: "staff" }, expires: "2099-01-01" } : null,
+  });
+
+  it("filters companies, retains draft/void, sums payments and preserves screen order", async () => {
+    const a = await testDb.company.create({ data: { name: "A", billingModel: "PER_PROJECT" } });
+    const b = await testDb.company.create({ data: { name: "B", billingModel: "PER_PROJECT" } });
+    const empty = await testDb.company.create({ data: { name: "Empty", billingModel: "PER_PROJECT" } });
+    for (const [index, companyId, status] of [[1, a.id, "DRAFT"], [2, b.id, "VOID"], [3, a.id, "PARTIAL"]] as const) {
+      const invoice = await testDb.invoice.create({ data: {
+        companyId, invoiceNumber: `FILTER-${index}`, issueDate: new Date(`2026-10-0${index}T00:00:00Z`),
+        currencyCode: "USD", subtotalMinor: 12345, totalMinor: 12345, status,
+      } });
+      if (status === "PARTIAL") await testDb.payment.createMany({ data: [2000, 345].map(amountMinor => ({
+        companyId, invoiceId: invoice.id, amountMinor, paidAt: new Date(),
+      })) });
+    }
+    const all = await caller(true).invoices();
+    expect(all.map(i => i.invoiceNumber)).toEqual(["FILTER-3", "FILTER-2", "FILTER-1"]);
+    expect(all[0]?.paidMinor).toBe(2345);
+    const selected = await caller(true).invoices({ companyId: a.id });
+    expect(selected.map(i => i.invoiceNumber)).toEqual(["FILTER-3", "FILTER-1"]);
+    expect(invoiceCsv(selected)).not.toContain("FILTER-2");
+    expect(invoiceCsv(await caller(true).invoices({ companyId: empty.id }))).toBe(`\uFEFF${INVOICE_CSV_HEADER}\r\n`);
+  });
+  it("rejects signed-out invoice queries before reading financial data", async () => {
+    await expect(caller(false).invoices()).rejects.toMatchObject({ code: "UNAUTHORIZED" });
+    await expect(caller(false).invoices({ companyId: "00000000-0000-4000-8000-000000000000" }))
+      .rejects.toMatchObject({ code: "UNAUTHORIZED" });
+  });
+});
diff --git a/DO6SQWGV/src/tests/money.test.ts b/DO6SQWGV/src/tests/money.test.ts
new file mode 100644
index 0000000..8003ffd
--- /dev/null
+++ b/DO6SQWGV/src/tests/money.test.ts
@@ -0,0 +1,25 @@
+import { describe, expect, it } from "vitest";
+
+import { formatMinor, minorUnitFactor, toMajor, toMinor } from "~/lib/money";
+
+describe("client currency minor units", () => {
+  it.each(["VND", "JPY", "KRW", "IRR", "IRT"])("keeps whole amounts for %s", (currency) => {
+    expect(minorUnitFactor(currency.toLowerCase())).toBe(1);
+    expect(toMinor(12345, currency)).toBe(12345);
+    expect(toMinor(5000, currency)).toBe(5000);
+    expect(toMajor(12345n, currency)).toBe(12345);
+  });
+
+  it.each(["USD", "EUR", "GBP", "AUD", "CAD", "SGD"])("keeps cents for %s", (currency) => {
+    expect(toMinor(123.45, currency)).toBe(12345);
+    expect(toMinor(1.01, currency)).toBe(101);
+    expect(toMajor(12345n, currency)).toBe(123.45);
+    expect(toMinor(0, currency)).toBe(0);
+    expect(toMinor(-1.25, currency)).toBe(-125);
+  });
+
+  it("formats a saved partial payment in its own currency", () => {
+    expect(formatMinor(5000, "VND")).toBe("₫5,000");
+    expect(formatMinor(12345, "USD")).toBe("$123.45");
+  });
+});
