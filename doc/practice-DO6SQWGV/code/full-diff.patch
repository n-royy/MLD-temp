diff --git a/DO6SQWGV/src/src/lib/invoice-csv.ts b/DO6SQWGV/src/src/lib/invoice-csv.ts
new file mode 100644
index 0000000..2a12a74
--- /dev/null
+++ b/DO6SQWGV/src/src/lib/invoice-csv.ts
@@ -0,0 +1,43 @@
+import { minorUnitFactor } from "~/lib/money";
+
+export interface InvoiceCsvRow {
+  invoiceNumber: string;
+  company: { name: string };
+  issueDate: Date;
+  dueDate: Date | null;
+  currencyCode: string;
+  totalMinor: number;
+  paidMinor: number;
+  status: string;
+}
+
+export const INVOICE_CSV_HEADER =
+  "invoice_number,company,issue_date,due_date,currency,total,paid,outstanding,status";
+
+function escapeField(value: string): string {
+  return /[",\r\n]/.test(value) ? `"${value.replace(/"/g, '""')}"` : value;
+}
+
+/** KB-EXP-01: preserve the authenticated list's selection, order and text. */
+export function invoiceCsv(invoices: readonly InvoiceCsvRow[]): string {
+  const rows = invoices.map((invoice) => {
+    const currency = invoice.currencyCode.toUpperCase();
+    const factor = minorUnitFactor(currency);
+    const amount = (minor: number) => (minor / factor).toFixed(factor === 1 ? 0 : 2);
+    const outstanding = ["SENT", "PARTIAL", "OVERDUE"].includes(invoice.status)
+      ? Math.max(0, invoice.totalMinor - invoice.paidMinor)
+      : 0;
+    return [
+      invoice.invoiceNumber,
+      invoice.company.name,
+      invoice.issueDate.toISOString().slice(0, 10),
+      invoice.dueDate?.toISOString().slice(0, 10) ?? "",
+      currency,
+      amount(invoice.totalMinor),
+      amount(invoice.paidMinor),
+      amount(outstanding),
+      invoice.status,
+    ].map(escapeField).join(",");
+  });
+  return `\uFEFF${[INVOICE_CSV_HEADER, ...rows].join("\r\n")}\r\n`;
+}
